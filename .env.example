APP_NAME="WorkBuddy Auth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------
# Database
# Mode A: DB_HOST=host.docker.internal (MySQL dari Laragon)
# Mode B: DB_HOST=db (MySQL container)
# ----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=workbuddy_auth
DB_USERNAME=workbuddy_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# ----------------------------------------------------------
# Bridge Key — dikirim WorkBuddy di header X-Bridge-Key
# Generate: openssl rand -hex 32
# ----------------------------------------------------------
BRIDGE_KEY=

# ----------------------------------------------------------
# JWT RS256
# Private key: hanya di Laravel,